<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="800.0" minHeight="800.0" prefHeight="800.0" prefWidth="950.0" style="-fx-background-color: #ECF0F1; -fx-padding: 20;" stylesheets="@CSS/hotel.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.ChambreManagerScene">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="55.0" layoutY="24.0" spacing="20" style="-fx-alignment: center;">
         <Label fx:id="titleLabel" styleClass="title-label" text="Gestion des Chambres" />
         <HBox fx:id="SearchBox" alignment="CENTER" spacing="10">
            <Label fx:id="labelSearch" style="-fx-font-weight: bold;" text="Chercher :" />
            <ComboBox fx:id="searchCriteria" minWidth="260.0" prefWidth="260.0" promptText="Critère de recherche" stylesheets="@CSS/ComboBoxCSS.css" />
            <TextField fx:id="SearchBar" prefHeight="30.0" prefWidth="300.0" promptText="Entrez votre recherche..." styleClass="search-bar" />
         </HBox>
         <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#addChambre" styleClass="action-button" text="Ajouter" />
            <Button mnemonicParsing="false" onAction="#refreshChambreTable" styleClass="action-button" text="Actualiser" />
         </HBox>
         <TableView fx:id="chambreTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="550.0" prefWidth="840.0" styleClass="table-view">
            <columns>
               <TableColumn fx:id="chambreNumbre" maxWidth="150.0" minWidth="87.0" prefWidth="87.0" text="N°Chambre" />
               <TableColumn fx:id="nomHotel" maxWidth="134.0" minWidth="50.0" prefWidth="111.0" text="Hôtel" />
               <TableColumn fx:id="chambreType" maxWidth="100.0" minWidth="50.0" prefWidth="77.0" text="Type" />
               <TableColumn fx:id="chambrePrix" maxWidth="100.0" minWidth="50.0" prefWidth="75.0" text="Prix" />
               <TableColumn fx:id="chambreOffre" prefWidth="75.0" text="Type offre" />
               <TableColumn fx:id="offreDescription" maxWidth="161.0" minWidth="63.0" prefWidth="73.0" text="Offre" />
               <TableColumn fx:id="chambreDescription" maxWidth="164.0" minWidth="79.0" prefWidth="131.0" text="Description" />
               <TableColumn fx:id="chambreStatut" maxWidth="150.0" minWidth="46.0" prefWidth="46.0" text="Statut" />
               <TableColumn fx:id="imageButton" prefWidth="58.0" text="Photo" />
               <TableColumn fx:id="editButton" maxWidth="143.0" minWidth="37.0" prefWidth="50.0" />
               <TableColumn fx:id="deleteButton" maxWidth="143.0" minWidth="26.0" prefWidth="51.0" />
            </columns>
         </TableView>
      </VBox>
   </children>
</AnchorPane>
