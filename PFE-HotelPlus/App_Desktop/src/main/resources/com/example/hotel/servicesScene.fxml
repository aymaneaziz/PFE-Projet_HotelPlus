<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="800.0" minHeight="800.0" prefHeight="800.0" prefWidth="950.0" style="-fx-background-color: #ECF0F1; -fx-padding: 20;" stylesheets="@CSS/hotel.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.ServiceManagerScene">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="55.0" layoutY="24.0" spacing="20" style="-fx-alignment: center;">
         <Label fx:id="titleLabel" styleClass="title-label" text="Gestion des Services" />
         <HBox alignment="CENTER" spacing="10">
            <Label fx:id="labelSearch" style="-fx-font-weight: bold;" text="Chercher :" />
            <ComboBox fx:id="searchCriteria" minWidth="260.0" prefWidth="260.0" promptText="Critère de recherche" stylesheets="@CSS/ComboBoxCSS.css" />
            <TextField fx:id="SearchBar" prefHeight="30.0" prefWidth="300.0" promptText="Entrez votre recherche..." styleClass="search-bar" />
         </HBox>
         <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#addService" styleClass="action-button" text="Ajouter" />
            <Button mnemonicParsing="false" onAction="#refreshServiceTable" styleClass="action-button" text="Actualiser" />
         </HBox>
         <TableView fx:id="serviceTable" prefHeight="550.0" prefWidth="840.0" styleClass="table-view">
            <columns>
               <TableColumn fx:id="serviceName" maxWidth="200.0" minWidth="100.0" prefWidth="129.0" text="Nom du Service" />
               <TableColumn fx:id="hotelName" maxWidth="200.0" minWidth="100.0" prefWidth="142.0" text="Hôtel" />
               <TableColumn fx:id="servicePrice" maxWidth="153.0" minWidth="46.0" prefWidth="71.0" text="Prix" />
               <TableColumn fx:id="serviceDescription" maxWidth="327.0" minWidth="150.0" prefWidth="246.0" text="Description" />
               <TableColumn fx:id="imageButton" prefWidth="72.0" text="photo" />
               <TableColumn fx:id="editButton" maxWidth="224.0" minWidth="50.0" prefWidth="95.0" />
               <TableColumn fx:id="deleteButton" maxWidth="200.0" minWidth="50.0" prefWidth="79.0" />
            </columns>
         </TableView>
      </VBox>
   </children>
</AnchorPane>
