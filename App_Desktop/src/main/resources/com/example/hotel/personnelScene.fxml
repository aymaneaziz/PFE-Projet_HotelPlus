<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="800.0" prefHeight="800.0" prefWidth="950.0" style="-fx-background-color: #ECF0F1; -fx-padding: 20;" stylesheets="@CSS/hotel.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.PersonnelManagerScene">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="69.0" layoutY="24.0" prefHeight="752.0" prefWidth="840.0" spacing="20" style="-fx-alignment: center;">
         <Label fx:id="titleLabel" prefHeight="62.0" prefWidth="338.0" styleClass="title-label" text="Gestion du Personnel" />
         <HBox alignment="CENTER" spacing="10">
            <Label fx:id="labelSearch" style="-fx-font-weight: bold;" text="Chercher :" />
            <ComboBox fx:id="searchCriteria" minWidth="260.0" prefWidth="260.0" promptText="Critère de recherche" stylesheets="@CSS/ComboBoxCSS.css" />
            <TextField fx:id="SearchBar" prefHeight="30.0" prefWidth="300.0" promptText="Entrez votre recherche..." styleClass="search-bar" />
         </HBox>
         <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#addPersonnel" styleClass="action-button" text="Ajouter" />
            <Button mnemonicParsing="false" onAction="#refreshPersonnelTable" styleClass="action-button" text="Actualiser" />
         </HBox>
         <TableView fx:id="personnelTable" prefHeight="550.0" prefWidth="840.0" styleClass="table-view">
            <columns>
               <TableColumn fx:id="hotelNameColumn" maxWidth="150.0" minWidth="100.0" prefWidth="101.0" text="Hôtel" />
               <TableColumn fx:id="lastNameColumn" maxWidth="150.0" minWidth="82.0" prefWidth="104.0" text="Nom" />
               <TableColumn fx:id="firstNameColumn" maxWidth="192.0" minWidth="76.0" prefWidth="90.0" text="Prénom" />
               <TableColumn fx:id="DDNColumn" maxWidth="219.0" minWidth="100.0" prefWidth="206.0" text="Date de Naissance" />
               <TableColumn fx:id="tacheColumn" maxWidth="208.0" minWidth="92.0" prefWidth="110.0" text="Tâche" />
               <TableColumn fx:id="salaryColumn" maxWidth="229.0" minWidth="82.0" prefWidth="93.0" text="Salaire" />
               <TableColumn fx:id="editButton" maxWidth="218.0" minWidth="50.0" prefWidth="60.0" />
               <TableColumn fx:id="deleteButton" maxWidth="174.0" minWidth="50.0" prefWidth="65.0" />
            </columns>
         </TableView>
      </VBox>
   </children>
</AnchorPane>
