<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="950.0" style="-fx-background-color: #ECF0F1; -fx-padding: 20;" stylesheets="@CSS/hotel.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.HotelManagerScene">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="55.0" layoutY="24.0" spacing="20" style="-fx-alignment: center;">
            <Label fx:id="titleLabel" styleClass="title-label" text="Gestion des Hôtels" />
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="labelSearch" style="-fx-font-weight: bold;" text="Chercher :" />
                <ComboBox fx:id="searchCriteria" minWidth="260.0" prefHeight="42.0" prefWidth="260.0" promptText="Critère de recherche" stylesheets="@CSS/ComboBoxCSS.css" />
                <TextField fx:id="SearchBar" prefHeight="30.0" prefWidth="300.0" promptText="Entrez votre recherche..." styleClass="search-bar" />
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="addButton" mnemonicParsing="false" onAction="#addHotel" styleClass="action-button" text="Ajouter" />
                <Button mnemonicParsing="false" onAction="#refreshHotelTable" styleClass="action-button" text="Actualiser" />
            </HBox>
            <TableView fx:id="hotelTable" prefHeight="550.0" prefWidth="840.0" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="hotelName" maxWidth="150.0" minWidth="100.0" prefWidth="125.0" text="Nom de l'hôtel" />
                    <TableColumn fx:id="hotelCountry" maxWidth="100.0" minWidth="50.0" prefWidth="75.0" text="Pays" />
                    <TableColumn fx:id="hotelCity" maxWidth="100.0" minWidth="50.0" prefWidth="75.0" text="Ville" />
                    <TableColumn fx:id="hotelAddress" maxWidth="200.0" minWidth="150.0" prefWidth="175.0" text="Adresse" />
                    <TableColumn fx:id="hotelChambre" maxWidth="100.0" minWidth="50.0" prefWidth="75.0" text="Chambres" />
                    <TableColumn fx:id="hotelStars" maxWidth="100.0" minWidth="50.0" prefWidth="75.0" text="Étoiles" />
                    <TableColumn fx:id="hotelType" maxWidth="100.0" minWidth="50.0" prefWidth="65.0" text="Type" />
               <TableColumn fx:id="imageButton" prefWidth="56.0" text="Photo" />
                    <TableColumn fx:id="editButton" maxWidth="100.0" minWidth="47.0" prefWidth="54.0" />
                    <TableColumn fx:id="deleteButton" maxWidth="100.0" minWidth="50.0" prefWidth="59.0" />
                </columns>
            </TableView>
        </VBox>
    </children>
</AnchorPane>
