<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="800.0" minHeight="800.0" prefHeight="800.0" prefWidth="950.0" style="-fx-background-color: #ECF0F1; -fx-padding: 20;" stylesheets="@CSS/hotel.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hotel.ReservationManagerScene">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="55.0" layoutY="24.0" spacing="20" style="-fx-alignment: center;">
         <Label fx:id="titleLabel" styleClass="title-label" text="Gestion des Réservations" />
         <HBox alignment="CENTER" spacing="10">
            <Label fx:id="labelSearch" style="-fx-font-weight: bold;" text="Chercher :" />
            <ComboBox fx:id="searchCriteria" minWidth="260.0" prefWidth="260.0" promptText="Critère de recherche" stylesheets="@CSS/ComboBoxCSS.css" />
            <TextField fx:id="SearchBar" prefHeight="30.0" prefWidth="300.0" promptText="Entrez votre recherche..." styleClass="search-bar" />
         </HBox>
         <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button mnemonicParsing="false" onAction="#refreshReservationTable" styleClass="action-button" text="Actualiser" />
         </HBox>
         <TableView fx:id="reservationTable" prefHeight="550.0" prefWidth="840.0" styleClass="table-view">
            <columns>
               <TableColumn fx:id="hotelNameColumn" maxWidth="150.0" minWidth="100.0" prefWidth="116.0" text="Hôtel" />
               <TableColumn fx:id="chambreNameColumn" maxWidth="150.0" minWidth="91.0" prefWidth="91.0" text="Chambre" />
               <TableColumn fx:id="clientLastNameColumn" maxWidth="168.0" minWidth="100.0" prefWidth="111.0" text="Nom du client" />
               <TableColumn fx:id="clientFirstNameColumn" maxWidth="182.0" minWidth="100.0" prefWidth="132.0" text="Prénom du client" />
               <TableColumn fx:id="dateDebutColumn" maxWidth="184.0" minWidth="100.0" prefWidth="100.0" text="Date de début" />
               <TableColumn fx:id="dateFinColumn" maxWidth="160.0" minWidth="86.0" prefWidth="88.0" text="Date de fin" />
               <TableColumn fx:id="statueColumn" maxWidth="223.0" minWidth="71.0" prefWidth="81.0" text="Statut" />
               <TableColumn fx:id="editButton" maxWidth="227.0" minWidth="20.0" prefWidth="51.0" />
               <TableColumn fx:id="deleteButton" maxWidth="220.0" minWidth="29.0" prefWidth="56.0" />
            </columns>
         </TableView>
      </VBox>
   </children>
</AnchorPane>
